# ============================================
# VARIABLES D'ENVIRONNEMENT - EXEMPLE
# Copier ce fichier en .env et modifier les valeurs
# ============================================

# Environnement (development, production, testing)
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# Sécurité
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire
JWT_SECRET_KEY=votre-cle-jwt-secrete-tres-longue-et-aleatoire

# Base de données locale (SQLite par défaut)
DB_TYPE=sqlite

# Pour utiliser PostgreSQL en développement, définir DB_TYPE=postgresql
# puis renseigner les paramètres ci-dessous.
# DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_cours_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe

# Une URL complète peut remplacer DB_TYPE et les paramètres DB_*.
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/gestion_cours_db

# Base de données PostgreSQL - AWS RDS (PRODUCTION)
# RDS_HOSTNAME=votre-instance.region.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB_NAME=gestion_cours_db
# RDS_USERNAME=admin
# RDS_PASSWORD=votre_mot_de_passe_rds

# Configuration CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Logging
SQL_ECHO=False

# Pagination
ITEMS_PER_PAGE=20

# AWS (pour déploiement futur)
# AWS_ACCESS_KEY_ID=votre_access_key
# AWS_SECRET_ACCESS_KEY=votre_secret_key
# AWS_REGION=eu-west-1
